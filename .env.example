APP_NAME="DWF Backoffice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dwf_backoffice
DB_USERNAME=dwf
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeder akun admin pertama. Wajib diisi sebelum `php artisan db:seed`.
DWF_ADMIN_NAME="DWF Admin"
DWF_ADMIN_EMAIL=
DWF_ADMIN_PASSWORD=

# reCAPTCHA v2 ("I'm not a robot") untuk halaman login.
# Ambil di https://www.google.com/recaptcha/admin/create — pilih
# "Challenge (v2)" > "I'm not a robot" Checkbox, lalu daftarkan domainnya.
# Kosongkan keduanya untuk mematikan captcha (mis. di lokal).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Tombol ganti bahasa di topbar. Mati = backoffice tampil dalam bahasa Inggris
# saja; terjemahan Indonesia tetap ada dan tinggal dinyalakan.
DWF_LOCALE_SWITCHER=false

# Otentikasi dua langkah (Google Authenticator). `false` mematikannya untuk
# semua orang; per pengguna diatur lewat kolom `users.two_factor_enabled`.
DWF_TWO_FACTOR=true

# Asal yang boleh memanggil API publik (`/api/*`), dipisah koma. Situs publik
# hidup di domainnya sendiri, jadi tanpa baris ini browser akan memblokirnya.
# Kosong = tidak ada yang diizinkan lintas asal — galat CORS yang terlihat di
# konsol jauh lebih baik daripada wildcard yang tidak terlihat di mana pun.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Berapa lama jejak audit disimpan. Dibersihkan `activitylog:clean`, yang
# dijadwalkan harian di routes/console.php — dan hanya benar-benar jalan
# kalau ada entri cron `schedule:run` di server.
ACTIVITY_LOG_RETENTION_DAYS=365
